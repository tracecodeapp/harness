{
  "name": "@tracecode/judge",
  "private": true,
  "version": "0.14.2",
  "description": "TraceKernel-native evaluation planning and execution for TraceCode runtimes.",
  "license": "AGPL-3.0-only",
  "homepage": "https://tracecode.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/tracecodeapp/harness.git",
    "directory": "packages/judge"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./tracekernel": {
      "types": "./dist/tracekernel.d.ts",
      "import": "./dist/tracekernel.js",
      "require": "./dist/tracekernel.cjs",
      "default": "./dist/tracekernel.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "tsx --tsconfig tsconfig.json --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tracecode/tracekernel": "workspace:*",
    "effect": "3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
