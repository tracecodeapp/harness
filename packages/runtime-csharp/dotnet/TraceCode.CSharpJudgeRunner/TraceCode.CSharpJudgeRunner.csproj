<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../TraceClr.AlgorithmProfile.props" />
  <Import Project="../TraceCode.CSharpCompatibilitySurface.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <WasmDebugLevel>0</WasmDebugLevel>
    <PublishTrimmed>false</PublishTrimmed>
    <WasmEmitSymbolMap>false</WasmEmitSymbolMap>
    <WasmMainJSPath>main.mjs</WasmMainJSPath>
    <TraceCodeRunnerTrimProfile Condition="'$(TraceCodeRunnerTrimProfile)' == ''">JudgeReferences</TraceCodeRunnerTrimProfile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TraceCodeRunnerTrimProfile)' == 'JudgeReferences'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TraceCode.CSharpJudgeRuntime/TraceCode.CSharpJudgeRuntime.csproj" />
    <Compile Include="../TraceCode.CSharpHost/TraceResponseJson.cs" Link="TraceResponseJson.cs" />
    <Compile Include="../TraceCode.CSharpHost/TraceClrAlgorithmResponseJson.cs" Link="TraceClrAlgorithmResponseJson.cs" />
  </ItemGroup>

  <!--
    Learner assemblies are compiled and loaded dynamically, so the linker
    cannot discover their BCL calls. Root every assembly exposed by the
    compiler's Minimal reference pack, plus corpus-discovered references;
    assemblies outside that language surface may still be removed as whole
    units. The general/project runtime and compiler authority are intentionally
    published without this profile.
  -->
  <ItemGroup Condition="'$(TraceCodeRunnerTrimProfile)' == 'JudgeReferences'">
    <TrimmerRootAssembly Include="@(TraceCodeCSharpCompatibilityAssembly)" />
    <TrimmerRootAssembly Include="@(TraceClrAlgorithmRunnerRootAssembly)" />
  </ItemGroup>
</Project>
