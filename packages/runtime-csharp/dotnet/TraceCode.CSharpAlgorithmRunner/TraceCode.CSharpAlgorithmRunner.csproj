<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../TraceClr.AlgorithmProfile.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <WasmDebugLevel>0</WasmDebugLevel>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <WasmEmitSymbolMap>false</WasmEmitSymbolMap>
    <WasmMainJSPath>main.mjs</WasmMainJSPath>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="@(TraceClrMinimalRunnerRootAssembly)" />
    <TrimmerRootAssembly Include="TraceCode.CSharpJudgeRuntime" />
    <ProjectReference Include="../TraceCode.CSharpJudgeRuntime/TraceCode.CSharpJudgeRuntime.csproj" />
    <Compile Include="../TraceCode.CSharpHost/TraceResponseJson.cs" Link="TraceResponseJson.cs" />
    <Compile Include="../TraceCode.CSharpHost/TraceClrAlgorithmResponseJson.cs" Link="TraceClrAlgorithmResponseJson.cs" />
    <Content Include="runner-worker.mjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
