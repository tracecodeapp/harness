{
  "name": "@tracecode/tracekernel",
  "private": true,
  "version": "0.16.0",
  "description": "Browser-native process, resource, and syscall kernel for TraceCode.",
  "license": "AGPL-3.0-only",
  "homepage": "https://tracecode.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/tracecodeapp/harness.git",
    "directory": "packages/tracekernel"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {
    "zlib": "./dist/zlib-browser-shim.js",
    "node:zlib": "./dist/zlib-browser-shim.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js",
      "require": "./dist/workspace.cjs",
      "default": "./dist/workspace.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "dependencies": {
    "@tracecode/runtime-contracts": "workspace:*",
    "effect": "3.22.0",
    "fflate": "^0.8.3",
    "just-bash": "3.1.0"
  }
}
