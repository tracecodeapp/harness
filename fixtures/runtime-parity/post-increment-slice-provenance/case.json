{
  "id": "post-increment-slice-provenance",
  "functionName": "solve",
  "executionStyle": "function",
  "inputs": {
    "nums": [
      10,
      20,
      30,
      40
    ]
  },
  "anchors": {
    "readPostIncrement": {
      "python": "pulled = left[i]",
      "javascript": "const pulled = left[i++];",
      "typescript": "const pulled = left[i++];",
      "java": "int pulled = left[i++];",
      "csharp": "int pulled = left[i++];",
      "cpp": "int pulled = left[i++];"
    },
    "writePostIncrement": {
      "python": "merged[k] = pulled",
      "javascript": "merged[k++] = pulled;",
      "typescript": "merged[k++] = pulled;",
      "java": "merged[k++] = pulled;",
      "csharp": "merged[k++] = pulled;",
      "cpp": "merged[k++] = pulled;"
    },
    "sliceFromMid": {
      "python": "tail = nums[mid:]",
      "javascript": "const tail = nums.slice(mid);",
      "typescript": "const tail = nums.slice(mid);",
      "java": "int[] tail = Arrays.copyOfRange(nums, mid, nums.length);",
      "csharp": "int[] tail = nums[mid..];",
      "cpp": "vector<int> tail(nums.begin() + mid, nums.end());"
    },
    "sliceToMid": {
      "python": "head = nums[:mid]",
      "javascript": "const head = nums.slice(0, mid);",
      "typescript": "const head = nums.slice(0, mid);",
      "java": "int[] head = Arrays.copyOfRange(nums, 0, mid);",
      "csharp": "int[] head = nums[0..mid];",
      "cpp": "vector<int> head(nums.begin(), nums.begin() + mid);"
    }
  },
