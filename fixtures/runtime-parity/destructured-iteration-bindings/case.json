{
  "id": "destructured-iteration-bindings",
  "functionName": "solve",
  "executionStyle": "function",
  "languages": ["python", "javascript", "typescript", "csharp", "cpp"],
  "inputs": {},
  "anchors": {
    "loop": {
      "python": "for course, prereq in prerequisites:",
      "javascript": "for (const [course, prereq] of prerequisites) {",
      "typescript": "for (const [course, prereq] of prerequisites) {",
      "csharp": "foreach (var (course, prereq) in prerequisites) {",
      "cpp": "for (auto [course, prereq] : prerequisites) {"
    }
  },
  "expect": {
    "loop": {
      "eventKinds": ["line", "read", "snapshot"],
      "variableSnapshots": ["course", "prereq", "prerequisites", "total"],
      "accessTargets": [
        { "kind": "read", "variable": "prerequisites", "pathDepth": 1 },
        { "kind": "read", "variable": "prerequisites", "pathDepth": 2 }
      ]
    }
  },
  "expectByLanguage": {
    "csharp": {
      "loop": {
