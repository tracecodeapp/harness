        "accessTargets": [
          { "kind": "read", "variable": "prerequisites", "pathDepth": 2 },
          { "kind": "write", "variable": "course" },
          { "kind": "write", "variable": "prereq" }
        ]
      }
    },
    "cpp": {
      "loop": {
        "eventKinds": ["line", "read", "snapshot"],
        "variableSnapshots": ["prerequisites", "total"],
        "accessTargets": [
          { "kind": "read", "variable": "prerequisites", "pathDepth": 1 },
          { "kind": "read", "variable": "prerequisites", "pathDepth": 2 }
        ]
      }
    }
  },
  "expectEventAssertions": {
    "loop": [
      { "kind": "read", "variable": "prerequisites", "path": [0, 0], "bindingVariable": "course", "value": 1 },
      { "kind": "read", "variable": "prerequisites", "path": [0, 1], "bindingVariable": "prereq", "value": 0 }
    ]
  }
}
