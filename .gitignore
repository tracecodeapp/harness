reports
tests/conformance/generated/

# Canonical C# general/compiler/runner ZIPs are tracked under csharp-role-artifacts.
# These verified trees are recreated by `pnpm materialize:csharp-role-assets`.
/workers/vendor/csharp/
/workers/vendor/csharp-compiler/
/workers/vendor/csharp-runner/

# Generated TraceCC release trees are content-addressed deployment artifacts.
# Regenerate them from the compiler/PCH releases and publish them to immutable
# runtime storage; never commit the local cache.
.cache/tracecc-runtime-assets/

# Verified package-owned engine archives are expanded here for release checks
# and asset installation. The immutable archives and manifests remain tracked
# in their owning npm packages.
.cache/runtime-package-assets/

# Generated package-publication assets. Regenerated by `pnpm build`.
packages/*/LICENSE
packages/*/THIRD_PARTY_NOTICES.md
packages/*/workers
