  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <ProjectReference Include="../../packages/runtime-csharp/dotnet/TraceCode.TraceClrWire/TraceCode.TraceClrWire.csproj" />
  </ItemGroup>
</Project>
