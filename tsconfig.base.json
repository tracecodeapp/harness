{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@tracecode/runtime-contracts": ["packages/runtime-contracts/src/index.ts"],
      "@tracecode/runtime-contracts/*": ["packages/runtime-contracts/src/*"],
      "@tracecode/runtime-browser": ["packages/runtime-browser/src/index.ts"],
      "@tracecode/runtime-browser/*": ["packages/runtime-browser/src/*"],
      "@tracecode/runtime-python": ["packages/runtime-python/src/index.ts"],
      "@tracecode/runtime-python/*": ["packages/runtime-python/src/*"],
      "@tracecode/runtime-javascript": ["packages/runtime-javascript/src/index.ts"],
      "@tracecode/runtime-javascript/*": ["packages/runtime-javascript/src/*"],
      "@tracecode/runtime-java": ["packages/runtime-java/src/index.ts"],
      "@tracecode/runtime-java/*": ["packages/runtime-java/src/*"],
      "@tracecode/runtime-csharp": ["packages/runtime-csharp/src/index.ts"],
      "@tracecode/runtime-csharp/*": ["packages/runtime-csharp/src/*"],
      "@tracecode/runtime-cpp": ["packages/runtime-cpp/src/index.ts"],
      "@tracecode/runtime-cpp/*": ["packages/runtime-cpp/src/*"],
      "@tracecode/runtime-native": ["packages/runtime-native/src/index.ts"],
      "@tracecode/runtime-native/*": ["packages/runtime-native/src/*"],
      "@tracecode/runtime-sql": ["packages/runtime-sql/src/index.ts"],
      "@tracecode/runtime-sql/*": ["packages/runtime-sql/src/*"],
      "@tracecode/judge": ["packages/judge/src/index.ts"],
      "@tracecode/judge/*": ["packages/judge/src/*"],
      "@tracecode/tracekernel": ["packages/tracekernel/src/index.ts"],
      "@tracecode/tracekernel/*": ["packages/tracekernel/src/*"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true
  }
}
