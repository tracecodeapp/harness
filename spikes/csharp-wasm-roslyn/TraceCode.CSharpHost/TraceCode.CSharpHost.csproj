<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>false</PublishTrimmed>
    <WasmEmitSymbolMap>false</WasmEmitSymbolMap>
    <WasmMainJSPath>main.mjs</WasmMainJSPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
  </ItemGroup>

  <Target Name="TraceCodeIncludeCompilerReferenceAssembliesInVfs" BeforeTargets="_WasmGenerateAppBundle">
    <ItemGroup>
      <TraceCodeCompilerReference Include="$(TargetDir)*.dll" />
      <TraceCodeCompilerReference Remove="$(TargetDir)System.Net*.dll" />
      <TraceCodeCompilerReference Remove="$(TargetDir)System.Runtime.InteropServices.JavaScript.dll" />
      <WasmFilesToIncludeInFileSystem
        Include="@(TraceCodeCompilerReference)"
        TargetPath="/tracecode-refs/%(TraceCodeCompilerReference.FileName)%(TraceCodeCompilerReference.Extension)" />
    </ItemGroup>
  </Target>
</Project>
